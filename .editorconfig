root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cpp,h,inc,in,cmake,rc}]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

# Windows command scripts must keep CRLF (see .gitattributes).
[*.{cmd,bat}]
end_of_line = crlf
indent_size = 2

[*.md]
trim_trailing_whitespace = false
