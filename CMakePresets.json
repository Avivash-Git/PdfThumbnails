{
  "version": 6,
  "cmakeMinimumRequired": { "major": 4, "minor": 3, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Ninja + cl.exe from a developer environment (scripts\\build.cmd sets it up).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "PDFT_SPECTRE": "AUTO",
        "PDFT_VERSION_SUFFIX": "$env{PDFT_VERSION_SUFFIX}"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "x64",
      "hidden": true,
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": { "PDFT_EXPECTED_ARCH": "x64" }
    },
    {
      "name": "arm64",
      "hidden": true,
      "description": "Cross-compiled on an x64 host (vcvarsall x64_arm64).",
      "architecture": { "value": "arm64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "ARM64",
        "PDFT_EXPECTED_ARCH": "arm64"
      }
    },
    { "name": "debug", "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "x64-debug", "displayName": "x64 Debug", "inherits": [ "base", "x64", "debug" ] },
    { "name": "x64-release", "displayName": "x64 Release", "inherits": [ "base", "x64", "release" ] },
    { "name": "arm64-debug", "displayName": "ARM64 Debug", "inherits": [ "base", "arm64", "debug" ] },
    { "name": "arm64-release", "displayName": "ARM64 Release", "inherits": [ "base", "arm64", "release" ] },
    {
      "name": "x64-asan",
      "displayName": "x64 Debug with AddressSanitizer",
      "description": "Local test runs only: /fsanitize=address everywhere, without the hardening that conflicts with it.",
      "inherits": [ "base", "x64", "debug" ],
      "cacheVariables": { "PDFT_ASAN": "ON" }
    },
    {
      "name": "ci-x64",
      "displayName": "CI x64 Release",
      "description": "What CI builds: Release, Spectre-mitigated runtime required, deterministic output.",
      "inherits": [ "base", "x64", "release" ],
      "cacheVariables": { "PDFT_SPECTRE": "ON", "PDFT_REPRODUCIBLE": "ON" }
    },
    {
      "name": "ci-arm64",
      "displayName": "CI ARM64 Release",
      "description": "What CI builds: Release, Spectre-mitigated runtime required, deterministic output.",
      "inherits": [ "base", "arm64", "release" ],
      "cacheVariables": { "PDFT_SPECTRE": "ON", "PDFT_REPRODUCIBLE": "ON" }
    },
    {
      "name": "release-x64",
      "displayName": "Release x64 (what the installer ships)",
      "description": "ci-x64 without the developer install commands, the tests and the tools: the runtime only.",
      "inherits": [ "ci-x64" ],
      "cacheVariables": { "PDFT_DEV_INSTALL": "OFF", "BUILD_TESTING": "OFF", "PDFT_BUILD_TOOLS": "OFF" }
    },
    {
      "name": "release-arm64",
      "displayName": "Release ARM64 (what the installer ships)",
      "description": "ci-arm64 without the developer install commands, the tests and the tools: the runtime only.",
      "inherits": [ "ci-arm64" ],
      "cacheVariables": { "PDFT_DEV_INSTALL": "OFF", "BUILD_TESTING": "OFF", "PDFT_BUILD_TOOLS": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "x64-debug", "configurePreset": "x64-debug" },
    { "name": "x64-release", "configurePreset": "x64-release" },
    { "name": "arm64-debug", "configurePreset": "arm64-debug" },
    { "name": "arm64-release", "configurePreset": "arm64-release" },
    { "name": "x64-asan", "configurePreset": "x64-asan" },
    { "name": "ci-x64", "configurePreset": "ci-x64" },
    { "name": "ci-arm64", "configurePreset": "ci-arm64" },
    { "name": "release-x64", "configurePreset": "release-x64" },
    { "name": "release-arm64", "configurePreset": "release-arm64" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true, "outputJUnitFile": "Testing/Temporary/junit.xml" },
      "execution": { "noTestsAction": "error", "timeout": 300 }
    },
    {
      "name": "x64-native",
      "hidden": true,
      "inherits": [ "test-base" ],
      "filter": { "exclude": { "label": "system|e2e|gui" } }
    },
    {
      "name": "arm64-cross",
      "hidden": true,
      "description": "ARM64 binaries cannot run on the x64 build host: static gates only.",
      "inherits": [ "test-base" ],
      "filter": { "include": { "label": "gate" } }
    },
    { "name": "x64-debug", "configurePreset": "x64-debug", "inherits": [ "x64-native" ] },
    { "name": "x64-release", "configurePreset": "x64-release", "inherits": [ "x64-native" ] },
    { "name": "arm64-debug", "configurePreset": "arm64-debug", "inherits": [ "arm64-cross" ] },
    { "name": "arm64-release", "configurePreset": "arm64-release", "inherits": [ "arm64-cross" ] },
    {
      "name": "x64-asan",
      "configurePreset": "x64-asan",
      "description": "Every program imports the AddressSanitizer runtime from outside System32, so the import, hardening and planting gates do not apply.",
      "inherits": [ "test-base" ],
      "filter": {
        "exclude": { "label": "system|e2e|gui", "name": "^gate\\.((imports|hardening)\\.(handler|settings|cli)|planting)$" }
      }
    },
    { "name": "ci-x64", "configurePreset": "ci-x64", "inherits": [ "x64-native" ] },
    { "name": "ci-arm64", "configurePreset": "ci-arm64", "inherits": [ "arm64-cross" ] }
  ],
  "workflowPresets": [
    {
      "name": "x64-debug",
      "steps": [
        { "type": "configure", "name": "x64-debug" },
        { "type": "build", "name": "x64-debug" },
        { "type": "test", "name": "x64-debug" }
      ]
    },
    {
      "name": "x64-release",
      "steps": [
        { "type": "configure", "name": "x64-release" },
        { "type": "build", "name": "x64-release" },
        { "type": "test", "name": "x64-release" }
      ]
    },
    {
      "name": "arm64-release",
      "steps": [
        { "type": "configure", "name": "arm64-release" },
        { "type": "build", "name": "arm64-release" },
        { "type": "test", "name": "arm64-release" }
      ]
    },
    {
      "name": "arm64-debug",
      "steps": [
        { "type": "configure", "name": "arm64-debug" },
        { "type": "build", "name": "arm64-debug" },
        { "type": "test", "name": "arm64-debug" }
      ]
    },
    {
      "name": "x64-asan",
      "steps": [
        { "type": "configure", "name": "x64-asan" },
        { "type": "build", "name": "x64-asan" },
        { "type": "test", "name": "x64-asan" }
      ]
    },
    {
      "name": "ci-x64",
      "steps": [
        { "type": "configure", "name": "ci-x64" },
        { "type": "build", "name": "ci-x64" },
        { "type": "test", "name": "ci-x64" }
      ]
    },
    {
      "name": "ci-arm64",
      "steps": [
        { "type": "configure", "name": "ci-arm64" },
        { "type": "build", "name": "ci-arm64" },
        { "type": "test", "name": "ci-arm64" }
      ]
    },
    {
      "name": "ci-x64-build",
      "steps": [
        { "type": "configure", "name": "ci-x64" },
        { "type": "build", "name": "ci-x64" }
      ]
    },
    {
      "name": "release-x64",
      "steps": [
        { "type": "configure", "name": "release-x64" },
        { "type": "build", "name": "release-x64" }
      ]
    },
    {
      "name": "release-arm64",
      "steps": [
        { "type": "configure", "name": "release-arm64" },
        { "type": "build", "name": "release-arm64" }
      ]
    }
  ]
}
