# clang-format 23.x (CI pins 23.1.3). Format: clang-format -i <files>
# Check: git ls-files "*.cpp" "*.h" "*.inc" | xargs clang-format --dry-run --Werror
BasedOnStyle: Google
ColumnLimit: 100
IncludeBlocks: Regroup
IncludeCategories:
  # <windows.h> first, in a block of its own: the other Windows headers depend on it.
  - Regex: '^<windows\.h>$'
    Priority: -1
  - Regex: '^<ext/.*\.h>'
    Priority: 2
  - Regex: '^<.*\.h>'
    Priority: 1
  - Regex: '^<.*'
    Priority: 2
  - Regex: '.*'
    Priority: 3
