<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Generated by CMake from cmake/templates/run-outside.manifest.in; do not edit.
     pdft-run-outside (developer tool, never shipped). Task Scheduler starts a second copy of it
     in the user's session; without a console of its own that copy opens no window. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="@PDFT_MANIFEST_NAME@" version="@PROJECT_VERSION@"
                    processorArchitecture="@PDFT_MANIFEST_ARCH@"/>
  <!-- Runs with the caller's token; the scheduled task asks for limited rights. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <!-- A console program that gets no console of its own when nothing hands it one: started
           from a terminal it uses that terminal as usual, but the copy that Task Scheduler
           starts gets no console window. Windows 11 24H2 and later; earlier versions ignore it
           and show a console window while the program runs. -->
      <consoleAllocationPolicy xmlns="http://schemas.microsoft.com/SMI/2024/WindowsSettings">detached</consoleAllocationPolicy>
    </windowsSettings>
  </application>
</assembly>
