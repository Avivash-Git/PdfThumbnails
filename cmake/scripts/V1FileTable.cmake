# Writes src/app/core/v1_files.inc: every file version 1.x copied into its per-user folder
# (%LOCALAPPDATA%\Programs\PdfThumbnails), by its path below that folder and the SHA-256 of its
# contents. The 1.x clean-up deletes a file of that folder only when its contents are in this
# table, because a per-user 2.x install shares the folder and may use some of the same names.
#
#   cmake -DRELEASE=<the 1.1 release folder> [-DTAG=v1.1.0] [-DOUT=<file>]
#         -P cmake/scripts/V1FileTable.cmake
#
# RELEASE is the folder 1.1's build script made (dist\PdfThumbnails: the manager, its launcher,
# README.md, LICENSE, licenses\ and bin\). The git tag TAG (the 1.1 import) adds its copies of
# the four files at the top. Text files are also hashed with every line ending as LF and as CRLF,
# since a checkout may have changed them. Run from anywhere; git must be on PATH. The table is
# data: it holds names and hashes, nothing about the PC it was made on.

cmake_minimum_required(VERSION 3.25)

get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT DEFINED TAG)
  set(TAG v1.1.0)
endif()
if(NOT DEFINED OUT)
  set(OUT "${_root}/src/app/core/v1_files.inc")
endif()
if(NOT DEFINED RELEASE OR NOT IS_DIRECTORY "${RELEASE}")
  message(FATAL_ERROR "RELEASE must name the 1.1 release folder (dist\\PdfThumbnails)")
endif()

# What 1.1's manager copied next to itself (PdfThumbnails.ps1, Copy-ManagerFiles).
set(_top_files PdfThumbnails.ps1 PdfThumbnails.cmd README.md LICENSE)
set(_folders licenses bin)

set(_entries "")

# _pdft_add(<relative path with forward slashes> <file>)
function(_pdft_add relative file)
  string(REPLACE "/" "\\\\" name "${relative}")
  file(SHA256 "${file}" hash)
  set(lines "{L\"${name}\", \"${hash}\"},")
  if(NOT relative MATCHES "\\.(dll|exe)$")
    file(READ "${file}" text)
    string(REPLACE "\r\n" "\n" lf "${text}")
    string(REPLACE "\n" "\r\n" crlf "${lf}")
    string(SHA256 lf_hash "${lf}")
    string(SHA256 crlf_hash "${crlf}")
    list(APPEND lines "{L\"${name}\", \"${lf_hash}\"}," "{L\"${name}\", \"${crlf_hash}\"},")
  endif()
  set(_entries ${_entries} ${lines} PARENT_SCOPE)
endfunction()

foreach(_name IN LISTS _top_files)
  if(EXISTS "${RELEASE}/${_name}")
    _pdft_add("${_name}" "${RELEASE}/${_name}")
  endif()
endforeach()
foreach(_folder IN LISTS _folders)
  file(GLOB_RECURSE _files LIST_DIRECTORIES false RELATIVE "${RELEASE}" "${RELEASE}/${_folder}/*")
  foreach(_relative IN LISTS _files)
    _pdft_add("${_relative}" "${RELEASE}/${_relative}")
  endforeach()
endforeach()

# The tag's copies, as git stores them and as an archive of the tag writes them.
set(_work "${CMAKE_CURRENT_BINARY_DIR}/v1-file-table-work")
file(REMOVE_RECURSE "${_work}")
file(MAKE_DIRECTORY "${_work}")
execute_process(COMMAND git -C "${_root}" archive --format=tar -o "${_work}/tag.tar" "${TAG}"
                RESULT_VARIABLE _git)
if(NOT _git EQUAL 0)
  message(FATAL_ERROR "git archive ${TAG} failed (${_git})")
endif()
file(ARCHIVE_EXTRACT INPUT "${_work}/tag.tar" DESTINATION "${_work}/tag" PATTERNS ${_top_files})
foreach(_name IN LISTS _top_files)
  if(EXISTS "${_work}/tag/${_name}")
    _pdft_add("${_name}" "${_work}/tag/${_name}")
  endif()
  execute_process(COMMAND git -C "${_root}" cat-file blob "${TAG}:${_name}"
                  OUTPUT_FILE "${_work}/${_name}.blob" RESULT_VARIABLE _git)
  if(_git EQUAL 0)
    _pdft_add("${_name}" "${_work}/${_name}.blob")
  endif()
endforeach()
file(REMOVE_RECURSE "${_work}")

list(REMOVE_DUPLICATES _entries)
list(SORT _entries CASE INSENSITIVE)
list(LENGTH _entries _count)

set(_text "// Generated by cmake/scripts/V1FileTable.cmake from the 1.1 release; regenerate it rather
// than edit it. Every file version 1.x copied into its per-user folder: the path below that
// folder and the SHA-256 of the contents (lower-case hex). Text files appear with their line
// endings as shipped, as LF and as CRLF. ${_count} entries.
// clang-format off
")
foreach(_line IN LISTS _entries)
  string(APPEND _text "    ${_line}\n")
endforeach()
string(APPEND _text "// clang-format on\n")
file(WRITE "${OUT}" "${_text}")
message(STATUS "Wrote ${OUT} (${_count} entries)")
