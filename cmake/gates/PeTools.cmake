# Helpers for the gate scripts and BuildId.cmake (all run with `cmake -P`): run dumpbin and
# parse its output, and read PE files directly where dumpbin has no option for the data
# (the version resource). Parsers use hex values wherever dumpbin prints them; the labels they
# anchor on are English, so the tests run with VSLANG=1033 (set again here for manual runs).

include_guard(GLOBAL)

set(ENV{VSLANG} 1033)

# pdft_gate_fail(<text>...): stops the gate with a message CTest shows on failure. The
# arguments are concatenated; CMake lists inside them show as "a, b, c".
function(pdft_gate_fail)
  set(text "")
  math(EXPR last "${ARGC} - 1")
  foreach(i RANGE 0 ${last})
    string(APPEND text "${ARGV${i}}")
  endforeach()
  string(REPLACE ";" ", " text "${text}")
  message(FATAL_ERROR "GATE FAILED: ${text}")
endfunction()

# pdft_gate_ok(<text>...): one line of evidence in the test log (arguments as above).
function(pdft_gate_ok)
  set(text "")
  math(EXPR last "${ARGC} - 1")
  foreach(i RANGE 0 ${last})
    string(APPEND text "${ARGV${i}}")
  endforeach()
  string(REPLACE ";" ", " text "${text}")
  message(STATUS "ok: ${text}")
endfunction()

# pdft_require(<var>...): every -D<var>=... the script needs is set.
function(pdft_require)
  foreach(var IN LISTS ARGN)
    if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
      message(FATAL_ERROR "${CMAKE_SCRIPT_MODE_FILE}: -D${var}=... is required")
    endif()
  endforeach()
endfunction()

# pdft_split(<out-list> <text> <separator>): the gates pass lists as one argument joined with
# ',' (names) or '|' (paths), because add_test() would split a ';' list into arguments.
function(pdft_split out text separator)
  if(text STREQUAL "")
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  string(REPLACE "${separator}" ";" list "${text}")
  set(${out} "${list}" PARENT_SCOPE)
endfunction()

# ---- dumpbin --------------------------------------------------------------------------------

# pdft_dumpbin(<out-var> <file> <option>...): dumpbin's output with LF line ends and no ';'
# (so the text can be split into a CMake list of lines).
function(pdft_dumpbin out file)
  pdft_require(DUMPBIN)
  if(NOT EXISTS "${file}")
    pdft_gate_fail("${file} does not exist")
  endif()
  execute_process(COMMAND "${DUMPBIN}" /nologo ${ARGN} "${file}"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE text ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "dumpbin ${ARGN} \"${file}\" failed (${rc}):\n${err}${text}")
  endif()
  string(REPLACE "\r" "" text "${text}")
  string(REPLACE ";" "," text "${text}")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

# pdft_lines(<out-list> <text>)
function(pdft_lines out text)
  string(REPLACE "\n" ";" lines "${text}")
  set(${out} "${lines}" PARENT_SCOPE)
endfunction()

# pdft_hex(<out-var> <hex digits>): the value as a decimal number.
function(pdft_hex out digits)
  math(EXPR value "0x${digits}" OUTPUT_FORMAT DECIMAL)
  set(${out} ${value} PARENT_SCOPE)
endfunction()

# pdft_has_bits(<out-var> <value> <mask>): TRUE if every bit of <mask> is set in <value>.
function(pdft_has_bits out value mask)
  math(EXPR masked "${value} & ${mask}" OUTPUT_FORMAT DECIMAL)
  math(EXPR mask "${mask}" OUTPUT_FORMAT DECIMAL)
  if(masked EQUAL mask)
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

# pdft_pe_exports(<out-list> <file>): the exported names (forwarders included; exports by
# ordinal only have no name and are counted by pdft_pe_export_counts instead).
function(pdft_pe_exports out file)
  pdft_dumpbin(text "${file}" /exports)
  set(names "")
  string(FIND "${text}" "ordinal hint RVA" start)
  if(start GREATER_EQUAL 0)
    string(SUBSTRING "${text}" ${start} -1 text)
    string(FIND "${text}" "\n  Summary" end)
    if(end GREATER 0)
      string(SUBSTRING "${text}" 0 ${end} text)
    endif()
    set(rva "[0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F]")
    pdft_lines(lines "${text}")
    foreach(line IN LISTS lines)
      if(line MATCHES "^ +[0-9]+ +[0-9A-F]+ +${rva} +([^ ]+)")
        list(APPEND names "${CMAKE_MATCH_1}")
      elseif(line MATCHES "^ +[0-9]+ +[0-9A-F]+ +([^ ]+) \\(forwarded to ")
        list(APPEND names "${CMAKE_MATCH_1}")
      endif()
    endforeach()
  endif()
  set(${out} "${names}" PARENT_SCOPE)
endfunction()

# pdft_pe_export_counts(<functions-var> <names-var> <file>): the export directory's counts
# (0 and 0 for an image without exports).
function(pdft_pe_export_counts functions_out names_out file)
  pdft_dumpbin(text "${file}" /exports)
  set(functions 0)
  set(names 0)
  if(text MATCHES "\n +([0-9]+) number of functions")
    set(functions ${CMAKE_MATCH_1})
  endif()
  if(text MATCHES "\n +([0-9]+) number of names")
    set(names ${CMAKE_MATCH_1})
  endif()
  set(${functions_out} ${functions} PARENT_SCOPE)
  set(${names_out} ${names} PARENT_SCOPE)
endfunction()

# pdft_pe_dependents(<static-out> <delay-out> <file>): the DLL names the image imports, as
# dumpbin spells them, statically and through delay-load descriptors.
function(pdft_pe_dependents static_out delay_out file)
  pdft_dumpbin(text "${file}" /dependents)
  foreach(kind IN ITEMS static delay)
    if(kind STREQUAL "static")
      set(header "Image has the following dependencies:")
    else()
      set(header "Image has the following delay load dependencies:")
    endif()
    set(found "")
    string(FIND "${text}" "${header}" start)
    if(start GREATER_EQUAL 0)
      string(LENGTH "${header}" length)
      math(EXPR start "${start} + ${length}")
      string(SUBSTRING "${text}" ${start} -1 rest)
      string(REGEX MATCH "^\n\n(    [^\n]+\n)+" block "${rest}")
      string(REGEX MATCHALL "    [^\n]+" items "${block}")
      foreach(item IN LISTS items)
        string(STRIP "${item}" item)
        list(APPEND found "${item}")
      endforeach()
    endif()
    set(${kind} "${found}")
  endforeach()
  set(${static_out} "${static}" PARENT_SCOPE)
  set(${delay_out} "${delay}" PARENT_SCOPE)
endfunction()

# pdft_pe_headers(<prefix> <file>): sets, from dumpbin /headers /loadconfig,
#   <prefix>_MACHINE           e.g. 8664, AA64 (hex digits as printed)
#   <prefix>_DLLCHAR           optional-header DLL characteristics (decimal)
#   <prefix>_EXTCHAR           extended DLL characteristics from the debug directory (decimal; 0
#                              when the image has none)
#   <prefix>_PDB               the CodeView (RSDS) PDB path recorded in the debug directory
#   <prefix>_DEPENDENT_LOAD    the load config's Dependent Load Flag (decimal; -1 if missing)
#   <prefix>_GUARD_FLAGS       the load config's Guard Flags (decimal; 0 if missing)
#   <prefix>_EHCONT_COUNT      Guard EH continuation count (decimal; 0 if missing)
function(pdft_pe_headers prefix file)
  pdft_dumpbin(text "${file}" /headers /loadconfig)
  if(NOT text MATCHES "\n +([0-9A-F]+) machine \\(")
    pdft_gate_fail("cannot read the machine type of ${file}")
  endif()
  set(${prefix}_MACHINE "${CMAKE_MATCH_1}" PARENT_SCOPE)
  if(NOT text MATCHES "\n +([0-9A-F]+) DLL characteristics")
    pdft_gate_fail("cannot read the DLL characteristics of ${file}")
  endif()
  pdft_hex(value "${CMAKE_MATCH_1}")
  set(${prefix}_DLLCHAR ${value} PARENT_SCOPE)
  set(value 0)
  if(text MATCHES "\n +([0-9A-F]+) extended DLL characteristics")
    pdft_hex(value "${CMAKE_MATCH_1}")
  endif()
  set(${prefix}_EXTCHAR ${value} PARENT_SCOPE)
  set(value "")
  if(text MATCHES "Format: RSDS, {[^}\n]*}, [0-9]+, ([^\n]*)")
    string(STRIP "${CMAKE_MATCH_1}" value)
  endif()
  set(${prefix}_PDB "${value}" PARENT_SCOPE)
  set(value -1)
  if(text MATCHES "\n +([0-9A-F]+) Dependent Load Flag")
    pdft_hex(value "${CMAKE_MATCH_1}")
  endif()
  set(${prefix}_DEPENDENT_LOAD ${value} PARENT_SCOPE)
  set(value 0)
  if(text MATCHES "\n +([0-9A-F]+) Guard Flags")
    pdft_hex(value "${CMAKE_MATCH_1}")
  endif()
  set(${prefix}_GUARD_FLAGS ${value} PARENT_SCOPE)
  set(value 0)
  if(text MATCHES "\n +([0-9A-F]+) Guard EH continuation count")
    pdft_hex(value "${CMAKE_MATCH_1}")
  endif()
  set(${prefix}_EHCONT_COUNT ${value} PARENT_SCOPE)
endfunction()

# ---- PE files read directly -----------------------------------------------------------------

# pdft_read_hex(<out-var> <file> <offset> <length>): lowercase hex digits of the bytes.
function(pdft_read_hex out file offset length)
  file(READ "${file}" hex OFFSET ${offset} LIMIT ${length} HEX)
  set(${out} "${hex}" PARENT_SCOPE)
endfunction()

# pdft_hex_le(<out-var> <hex> <byte offset> <size>): the little-endian unsigned integer of
# <size> bytes at <byte offset> in a hex dump, as a decimal number.
function(pdft_hex_le out hex offset size)
  set(digits "")
  math(EXPR last "${size} - 1")
  foreach(i RANGE ${last})
    math(EXPR at "(${offset} + ${i}) * 2")
    string(SUBSTRING "${hex}" ${at} 2 byte)
    set(digits "${byte}${digits}")
  endforeach()
  pdft_hex(value "${digits}")
  set(${out} ${value} PARENT_SCOPE)
endfunction()

# pdft_pe_section(<offset-var> <size-var> <file> <name>): the file offset and raw size of a
# section (e.g. .rsrc), from the PE headers. Both are -1 if the image has no such section.
function(pdft_pe_section offset_out size_out file name)
  pdft_read_hex(dos "${file}" 0 64)
  string(SUBSTRING "${dos}" 0 4 magic)
  if(NOT magic STREQUAL "4d5a")
    pdft_gate_fail("${file} is not a PE file (no MZ header)")
  endif()
  pdft_hex_le(pe "${dos}" 60 4)
  pdft_read_hex(coff "${file}" ${pe} 24)
  string(SUBSTRING "${coff}" 0 8 signature)
  if(NOT signature STREQUAL "50450000")
    pdft_gate_fail("${file} is not a PE file (no PE signature)")
  endif()
  pdft_hex_le(sections "${coff}" 6 2)
  pdft_hex_le(optional "${coff}" 20 2)
  math(EXPR table "${pe} + 24 + ${optional}")
  math(EXPR length "${sections} * 40")
  pdft_read_hex(headers "${file}" ${table} ${length})
  string(HEX "${name}" wanted)   # section names are 8 bytes, zero-padded
  string(LENGTH "${wanted}" digits)
  while(digits LESS 16)
    string(APPEND wanted "0")
    math(EXPR digits "${digits} + 1")
  endwhile()
  string(SUBSTRING "${wanted}" 0 16 wanted)
  math(EXPR last "${sections} - 1")
  foreach(i RANGE ${last})
    math(EXPR at "${i} * 80")
    string(SUBSTRING "${headers}" ${at} 16 section_name)
    if(section_name STREQUAL wanted)
      math(EXPR base "${i} * 40")
      pdft_hex_le(size "${headers}" ${base}+16 4)
      pdft_hex_le(offset "${headers}" ${base}+20 4)
      set(${offset_out} ${offset} PARENT_SCOPE)
      set(${size_out} ${size} PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${offset_out} -1 PARENT_SCOPE)
  set(${size_out} -1 PARENT_SCOPE)
endfunction()

# pdft_utf16_hex(<out-var> <ascii text>): the UTF-16LE bytes of <text> as lowercase hex.
function(pdft_utf16_hex out text)
  string(HEX "${text}" hex)
  string(REGEX REPLACE "(..)" "\\100" hex "${hex}")
  set(${out} "${hex}" PARENT_SCOPE)
endfunction()

# pdft_find_aligned(<out-var> <haystack hex> <needle hex> <alignment in bytes>): the first
# hex-digit index of <needle> whose byte offset is a multiple of <alignment>, or -1.
function(pdft_find_aligned out haystack needle alignment)
  math(EXPR step "${alignment} * 2")
  set(base 0)
  set(rest "${haystack}")
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at LESS 0)
      set(${out} -1 PARENT_SCOPE)
      return()
    endif()
    math(EXPR index "${base} + ${at}")
    math(EXPR misaligned "${index} % ${step}")
    if(misaligned EQUAL 0)
      set(${out} ${index} PARENT_SCOPE)
      return()
    endif()
    math(EXPR skip "${at} + 1")
    math(EXPR base "${base} + ${skip}")
    string(SUBSTRING "${rest}" ${skip} -1 rest)
  endwhile()
endfunction()

# pdft_pe_version(<prefix> <file> <key>...): reads the VERSIONINFO resource and sets
#   <prefix>_<key>    the StringFileInfo value of each <key> (e.g. FileVersion,
#                     OriginalFilename), or "" if absent (ASCII values only)
#   <prefix>_FIXED    the VS_FIXEDFILEINFO file version "a.b.c.d", or "" if absent
function(pdft_pe_version prefix file)
  pdft_pe_section(offset size "${file}" ".rsrc")
  if(offset LESS 0)
    pdft_gate_fail("${file} has no resource section")
  endif()
  pdft_read_hex(rsrc "${file}" ${offset} ${size})

  # VS_FIXEDFILEINFO: DWORD-aligned signature 0xFEEF04BD, then dwStrucVersion, dwFileVersionMS,
  # dwFileVersionLS.
  set(fixed "")
  pdft_find_aligned(at "${rsrc}" "bd04effe" 4)
  if(at GREATER_EQUAL 0)
    math(EXPR byte "${at} / 2")
    pdft_hex_le(ms "${rsrc}" ${byte}+8 4)
    pdft_hex_le(ls "${rsrc}" ${byte}+12 4)
    math(EXPR a "${ms} >> 16")
    math(EXPR b "${ms} & 65535")
    math(EXPR c "${ls} >> 16")
    math(EXPR d "${ls} & 65535")
    set(fixed "${a}.${b}.${c}.${d}")
  endif()
  set(${prefix}_FIXED "${fixed}" PARENT_SCOPE)

  # String structures: WORD wLength, WORD wValueLength (in WCHARs), WORD wType, WCHAR szKey[]
  # (with its terminator), padding to a DWORD, WCHAR Value[] (with its terminator). Every
  # structure starts on a DWORD, counted from the start of the VS_VERSIONINFO block (the resource
  # data; byte offsets below are from the start of the section).
  set(block 0)
  pdft_utf16_hex(needle "VS_VERSION_INFO")
  pdft_find_aligned(at "${rsrc}" "${needle}0000" 2)
  if(at GREATER_EQUAL 12)
    math(EXPR block "${at} / 2 - 6")
  endif()
  # A key follows its 6-byte header, so it starts 2 bytes past a DWORD of the block.
  math(EXPR from "(${block} + 2) * 2")
  string(SUBSTRING "${rsrc}" ${from} -1 keys)
  foreach(key IN LISTS ARGN)
    set(value "")
    pdft_utf16_hex(needle "${key}")
    string(APPEND needle "0000")
    pdft_find_aligned(at "${keys}" "${needle}" 4)
    if(at GREATER_EQUAL 0)
      math(EXPR header "${block} + 2 + ${at} / 2 - 6")
      pdft_hex_le(length "${rsrc}" ${header} 2)
      pdft_hex_le(value_length "${rsrc}" ${header}+2 2)
      string(LENGTH "${needle}" digits)
      math(EXPR key_end "${header} + 6 + ${digits} / 2")
      math(EXPR byte "${block} + ((${key_end} - ${block} + 3) & ~3)")
      math(EXPR end "${byte} + 2 * ${value_length}")
      math(EXPR struct_end "${header} + ${length}")
      if(end GREATER struct_end)
        set(end ${struct_end})
      endif()
      while(byte LESS end)
        math(EXPR at "${byte} * 2")
        string(SUBSTRING "${rsrc}" ${at} 4 word)
        if(word STREQUAL "0000" OR word STREQUAL "")
          break()
        endif()
        string(SUBSTRING "${word}" 2 2 high)
        if(NOT high STREQUAL "00")
          pdft_gate_fail("${file}: the ${key} value is not ASCII")
        endif()
        string(SUBSTRING "${word}" 0 2 low)
        pdft_hex(code "${low}")
        string(ASCII ${code} char)
        string(APPEND value "${char}")
        math(EXPR byte "${byte} + 2")
      endwhile()
    endif()
    set(${prefix}_${key} "${value}" PARENT_SCOPE)
  endforeach()
endfunction()
