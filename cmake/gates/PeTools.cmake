# Helpers for the gate scripts and BuildId.cmake (all run with `cmake -P`): run dumpbin and
# parse its output, and read PE files directly where dumpbin has no option for the data (the
# version and manifest resources). Parsers use hex values wherever dumpbin prints them; the
# labels they anchor on are English, so the tests run with VSLANG=1033 (set again here for
# manual runs).

include_guard(GLOBAL)

set(ENV{VSLANG} 1033)

# pdft_gate_fail(<text>...): stops the gate with a message CTest shows on failure. The
# arguments are concatenated; CMake lists inside them show as "a, b, c".
function(pdft_gate_fail)
  set(text "")
  math(EXPR last "${ARGC} - 1")
  foreach(i RANGE 0 ${last})
    string(APPEND text "${ARGV${i}}")
  endforeach()
  string(REPLACE ";" ", " text "${text}")
  message(FATAL_ERROR "GATE FAILED: ${text}")
endfunction()

# pdft_gate_ok(<text>...): one line of evidence in the test log (arguments as above).
function(pdft_gate_ok)
  set(text "")
  math(EXPR last "${ARGC} - 1")
  foreach(i RANGE 0 ${last})
    string(APPEND text "${ARGV${i}}")
  endforeach()
  string(REPLACE ";" ", " text "${text}")
  message(STATUS "ok: ${text}")
endfunction()

# pdft_require(<var>...): every -D<var>=... the script needs is set.
function(pdft_require)
  foreach(var IN LISTS ARGN)
    if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
      message(FATAL_ERROR "${CMAKE_SCRIPT_MODE_FILE}: -D${var}=... is required")
    endif()
  endforeach()
endfunction()

# pdft_split(<out-list> <text> <separator>): the gates pass lists as one argument joined with
# ',' (names) or '|' (paths), because add_test() would split a ';' list into arguments.
function(pdft_split out text separator)
  if(text STREQUAL "")
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  string(REPLACE "${separator}" ";" list "${text}")
  set(${out} "${list}" PARENT_SCOPE)
endfunction()

# ---- dumpbin --------------------------------------------------------------------------------

# pdft_dumpbin(<out-var> <file> <option>...): dumpbin's output with LF line ends and no ';'
# (so the text can be split into a CMake list of lines).
function(pdft_dumpbin out file)
  pdft_require(DUMPBIN)
  if(NOT EXISTS "${file}")
    pdft_gate_fail("${file} does not exist")
  endif()
  execute_process(COMMAND "${DUMPBIN}" /nologo ${ARGN} "${file}"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE text ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "dumpbin ${ARGN} \"${file}\" failed (${rc}):\n${err}${text}")
  endif()
  string(REPLACE "\r" "" text "${text}")
  string(REPLACE ";" "," text "${text}")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

# pdft_lines(<out-list> <text>)
function(pdft_lines out text)
  string(REPLACE "\n" ";" lines "${text}")
  set(${out} "${lines}" PARENT_SCOPE)
endfunction()

# pdft_hex(<out-var> <hex digits>): the value as a decimal number.
function(pdft_hex out digits)
  math(EXPR value "0x${digits}" OUTPUT_FORMAT DECIMAL)
  set(${out} ${value} PARENT_SCOPE)
endfunction()

# pdft_has_bits(<out-var> <value> <mask>): TRUE if every bit of <mask> is set in <value>.
function(pdft_has_bits out value mask)
  math(EXPR masked "${value} & ${mask}" OUTPUT_FORMAT DECIMAL)
  math(EXPR mask "${mask}" OUTPUT_FORMAT DECIMAL)
  if(masked EQUAL mask)
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

# pdft_pe_exports(<out-list> <file>): the exported names (forwarders included; exports by
# ordinal only have no name and are counted by pdft_pe_export_counts instead).
function(pdft_pe_exports out file)
  pdft_dumpbin(text "${file}" /exports)
  set(names "")
  string(FIND "${text}" "ordinal hint RVA" start)
  if(start GREATER_EQUAL 0)
    string(SUBSTRING "${text}" ${start} -1 text)
    string(FIND "${text}" "\n  Summary" end)
    if(end GREATER 0)
      string(SUBSTRING "${text}" 0 ${end} text)
    endif()
    set(rva "[0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F][0-9A-F]")
    pdft_lines(lines "${text}")
    foreach(line IN LISTS lines)
      if(line MATCHES "^ +[0-9]+ +[0-9A-F]+ +${rva} +([^ ]+)")
        list(APPEND names "${CMAKE_MATCH_1}")
      elseif(line MATCHES "^ +[0-9]+ +[0-9A-F]+ +([^ ]+) \\(forwarded to ")
        list(APPEND names "${CMAKE_MATCH_1}")
      endif()
    endforeach()
  endif()
  set(${out} "${names}" PARENT_SCOPE)
endfunction()

# pdft_pe_export_counts(<functions-var> <names-var> <file>): the export directory's counts
# (0 and 0 for an image without exports).
function(pdft_pe_export_counts functions_out names_out file)
  pdft_dumpbin(text "${file}" /exports)
  set(functions 0)
  set(names 0)
  if(text MATCHES "\n +([0-9]+) number of functions")
    set(functions ${CMAKE_MATCH_1})
  endif()
  if(text MATCHES "\n +([0-9]+) number of names")
    set(names ${CMAKE_MATCH_1})
  endif()
  set(${functions_out} ${functions} PARENT_SCOPE)
  set(${names_out} ${names} PARENT_SCOPE)
endfunction()

# pdft_pe_dependents(<static-out> <delay-out> <file>): the DLL names the image imports, as
# dumpbin spells them, statically and through delay-load descriptors.
function(pdft_pe_dependents static_out delay_out file)
  pdft_dumpbin(text "${file}" /dependents)
  foreach(kind IN ITEMS static delay)
    if(kind STREQUAL "static")
      set(header "Image has the following dependencies:")
    else()
      set(header "Image has the following delay load dependencies:")
    endif()
    set(found "")
    string(FIND "${text}" "${header}" start)
    if(start GREATER_EQUAL 0)
      string(LENGTH "${header}" length)
      math(EXPR start "${start} + ${length}")
      string(SUBSTRING "${text}" ${start} -1 rest)
      string(REGEX MATCH "^\n\n(    [^\n]+\n)+" block "${rest}")
      string(REGEX MATCHALL "    [^\n]+" items "${block}")
      foreach(item IN LISTS items)
        string(STRIP "${item}" item)
        list(APPEND found "${item}")
      endforeach()
    endif()
    set(${kind} "${found}")
  endforeach()
  set(${static_out} "${static}" PARENT_SCOPE)
  set(${delay_out} "${delay}" PARENT_SCOPE)
endfunction()

# pdft_pe_headers(<prefix> <file>): sets, from dumpbin /headers /loadconfig,
#   <prefix>_MACHINE           e.g. 8664, AA64 (hex digits as printed)
#   <prefix>_DLLCHAR           optional-header DLL characteristics (decimal)
#   <prefix>_EXTCHAR           extended DLL characteristics from the debug directory (decimal; 0
#                              when the image has none)
#   <prefix>_PDB               the CodeView (RSDS) PDB path recorded in the debug directory
#   <prefix>_DEPENDENT_LOAD    the load config's Dependent Load Flag (decimal; -1 if missing)
#   <prefix>_GUARD_FLAGS       the load config's Guard Flags (decimal; 0 if missing)
#   <prefix>_EHCONT_COUNT      Guard EH continuation count (decimal; 0 if missing)
function(pdft_pe_headers prefix file)
  pdft_dumpbin(text "${file}" /headers /loadconfig)
  if(NOT text MATCHES "\n +([0-9A-F]+) machine \\(")
    pdft_gate_fail("cannot read the machine type of ${file}")
  endif()
  set(${prefix}_MACHINE "${CMAKE_MATCH_1}" PARENT_SCOPE)
  if(NOT text MATCHES "\n +([0-9A-F]+) DLL characteristics")
    pdft_gate_fail("cannot read the DLL characteristics of ${file}")
  endif()
  pdft_hex(value "${CMAKE_MATCH_1}")
  set(${prefix}_DLLCHAR ${value} PARENT_SCOPE)
  set(value 0)
  if(text MATCHES "\n +([0-9A-F]+) extended DLL characteristics")
    pdft_hex(value "${CMAKE_MATCH_1}")
  endif()
  set(${prefix}_EXTCHAR ${value} PARENT_SCOPE)
  set(value "")
  if(text MATCHES "Format: RSDS, {[^}\n]*}, [0-9]+, ([^\n]*)")
    string(STRIP "${CMAKE_MATCH_1}" value)
  endif()
  set(${prefix}_PDB "${value}" PARENT_SCOPE)
  set(value -1)
  if(text MATCHES "\n +([0-9A-F]+) Dependent Load Flag")
    pdft_hex(value "${CMAKE_MATCH_1}")
  endif()
  set(${prefix}_DEPENDENT_LOAD ${value} PARENT_SCOPE)
  set(value 0)
  if(text MATCHES "\n +([0-9A-F]+) Guard Flags")
    pdft_hex(value "${CMAKE_MATCH_1}")
  endif()
  set(${prefix}_GUARD_FLAGS ${value} PARENT_SCOPE)
  set(value 0)
  if(text MATCHES "\n +([0-9A-F]+) Guard EH continuation count")
    pdft_hex(value "${CMAKE_MATCH_1}")
  endif()
  set(${prefix}_EHCONT_COUNT ${value} PARENT_SCOPE)
endfunction()

# ---- PE files read directly -----------------------------------------------------------------

# pdft_read_hex(<out-var> <file> <offset> <length>): lowercase hex digits of the bytes.
function(pdft_read_hex out file offset length)
  file(READ "${file}" hex OFFSET ${offset} LIMIT ${length} HEX)
  set(${out} "${hex}" PARENT_SCOPE)
endfunction()

# pdft_hex_le(<out-var> <hex> <byte offset> <size>): the little-endian unsigned integer of
# <size> bytes at <byte offset> in a hex dump, as a decimal number.
function(pdft_hex_le out hex offset size)
  set(digits "")
  math(EXPR last "${size} - 1")
  foreach(i RANGE ${last})
    math(EXPR at "(${offset} + ${i}) * 2")
    string(SUBSTRING "${hex}" ${at} 2 byte)
    set(digits "${byte}${digits}")
  endforeach()
  pdft_hex(value "${digits}")
  set(${out} ${value} PARENT_SCOPE)
endfunction()

# pdft_pe_section(<offset-var> <size-var> <file> <name> [<rva-var>]): the file offset and raw
# size of a section (e.g. .rsrc), and optionally its relative virtual address, from the PE
# headers. All are -1 if the image has no such section.
function(pdft_pe_section offset_out size_out file name)
  pdft_read_hex(dos "${file}" 0 64)
  string(SUBSTRING "${dos}" 0 4 magic)
  if(NOT magic STREQUAL "4d5a")
    pdft_gate_fail("${file} is not a PE file (no MZ header)")
  endif()
  pdft_hex_le(pe "${dos}" 60 4)
  pdft_read_hex(coff "${file}" ${pe} 24)
  string(SUBSTRING "${coff}" 0 8 signature)
  if(NOT signature STREQUAL "50450000")
    pdft_gate_fail("${file} is not a PE file (no PE signature)")
  endif()
  pdft_hex_le(sections "${coff}" 6 2)
  pdft_hex_le(optional "${coff}" 20 2)
  math(EXPR table "${pe} + 24 + ${optional}")
  math(EXPR length "${sections} * 40")
  pdft_read_hex(headers "${file}" ${table} ${length})
  string(HEX "${name}" wanted)   # section names are 8 bytes, zero-padded
  string(LENGTH "${wanted}" digits)
  while(digits LESS 16)
    string(APPEND wanted "0")
    math(EXPR digits "${digits} + 1")
  endwhile()
  string(SUBSTRING "${wanted}" 0 16 wanted)
  math(EXPR last "${sections} - 1")
  foreach(i RANGE ${last})
    math(EXPR at "${i} * 80")
    string(SUBSTRING "${headers}" ${at} 16 section_name)
    if(section_name STREQUAL wanted)
      math(EXPR base "${i} * 40")
      pdft_hex_le(rva "${headers}" ${base}+12 4)
      pdft_hex_le(size "${headers}" ${base}+16 4)
      pdft_hex_le(offset "${headers}" ${base}+20 4)
      set(${offset_out} ${offset} PARENT_SCOPE)
      set(${size_out} ${size} PARENT_SCOPE)
      if(ARGC GREATER 4)
        set(${ARGV4} ${rva} PARENT_SCOPE)
      endif()
      return()
    endif()
  endforeach()
  set(${offset_out} -1 PARENT_SCOPE)
  set(${size_out} -1 PARENT_SCOPE)
  if(ARGC GREATER 4)
    set(${ARGV4} -1 PARENT_SCOPE)
  endif()
endfunction()

# pdft_rsrc_entries(<out-list> <rsrc hex> <rsrc size> <directory offset> <file>): the entries of
# one IMAGE_RESOURCE_DIRECTORY in the .rsrc section, as "<id>:<kind>:<offset>" items: <id> is
# the numeric ID or "name" (named entries), <kind> is "dir" (a subdirectory) or "data" (an
# IMAGE_RESOURCE_DATA_ENTRY), <offset> is from the start of the section. <file> is for messages.
function(pdft_rsrc_entries out rsrc size dir file)
  math(EXPR header_end "${dir} + 16")
  if(dir LESS 0 OR header_end GREATER size)
    pdft_gate_fail("${file}: resource directory at ${dir} lies outside the resource section")
  endif()
  pdft_hex_le(named "${rsrc}" ${dir}+12 2)
  pdft_hex_le(ids "${rsrc}" ${dir}+14 2)
  math(EXPR count "${named} + ${ids}")
  math(EXPR entries_end "${header_end} + 8 * ${count}")
  if(entries_end GREATER size)
    pdft_gate_fail("${file}: resource directory at ${dir} has more entries than fit in the section")
  endif()
  set(items "")
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
      math(EXPR at "${header_end} + 8 * ${i}")
      pdft_hex_le(name "${rsrc}" ${at} 4)
      pdft_hex_le(data "${rsrc}" ${at}+4 4)
      math(EXPR is_named "${name} >> 31")
      if(is_named)
        set(id "name")
      else()
        set(id ${name})
      endif()
      math(EXPR is_dir "${data} >> 31")
      math(EXPR target "${data} & 0x7FFFFFFF")
      if(is_dir)
        list(APPEND items "${id}:dir:${target}")
      else()
        list(APPEND items "${id}:data:${target}")
      endif()
    endforeach()
  endif()
  set(${out} "${items}" PARENT_SCOPE)
endfunction()

# pdft_pe_resources(<out-list> <file> <type>): every resource of one numeric type (16 =
# RT_VERSION, 24 = RT_MANIFEST), found by walking the resource directory (type, name, language),
# as "<id>:<language>:<file offset>:<size>" items; <id> is "name" for a named resource. Empty
# when the image has no resources of that type.
function(pdft_pe_resources out file type)
  pdft_pe_section(offset size "${file}" ".rsrc" rva)
  if(offset LESS 0)
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  pdft_read_hex(rsrc "${file}" ${offset} ${size})
  set(found "")
  pdft_rsrc_entries(types "${rsrc}" ${size} 0 "${file}")
  foreach(type_item IN LISTS types)
    string(REPLACE ":" ";" type_item "${type_item}")
    list(GET type_item 0 type_id)
    list(GET type_item 1 type_kind)
    list(GET type_item 2 type_at)
    if(NOT type_id STREQUAL type OR NOT type_kind STREQUAL "dir")
      continue()
    endif()
    pdft_rsrc_entries(names "${rsrc}" ${size} ${type_at} "${file}")
    foreach(name_item IN LISTS names)
      string(REPLACE ":" ";" name_item "${name_item}")
      list(GET name_item 0 name_id)
      list(GET name_item 1 name_kind)
      list(GET name_item 2 name_at)
      if(NOT name_kind STREQUAL "dir")
        pdft_gate_fail("${file}: resource ${type}/${name_id} has no language level")
      endif()
      pdft_rsrc_entries(languages "${rsrc}" ${size} ${name_at} "${file}")
      foreach(language_item IN LISTS languages)
        string(REPLACE ":" ";" language_item "${language_item}")
        list(GET language_item 0 language)
        list(GET language_item 1 language_kind)
        list(GET language_item 2 entry)
        math(EXPR entry_end "${entry} + 16")
        if(NOT language_kind STREQUAL "data" OR entry_end GREATER size)
          pdft_gate_fail("${file}: resource ${type}/${name_id}/${language} is malformed")
        endif()
        # IMAGE_RESOURCE_DATA_ENTRY: OffsetToData (an RVA), Size, CodePage, Reserved.
        pdft_hex_le(data_rva "${rsrc}" ${entry} 4)
        pdft_hex_le(data_size "${rsrc}" ${entry}+4 4)
        math(EXPR data_at "${data_rva} - ${rva}")
        math(EXPR data_end "${data_at} + ${data_size}")
        if(data_at LESS 0 OR data_end GREATER size)
          pdft_gate_fail("${file}: resource ${type}/${name_id}/${language} lies outside the resource section")
        endif()
        math(EXPR data_offset "${offset} + ${data_at}")
        list(APPEND found "${name_id}:${language}:${data_offset}:${data_size}")
      endforeach()
    endforeach()
  endforeach()
  set(${out} "${found}" PARENT_SCOPE)
endfunction()

# pdft_utf16_text(<out-var> <hex> <byte offset> <end offset> <file> <what>): the UTF-16LE text at
# <byte offset> in a hex dump, up to its NUL terminator or <end offset> (exclusive), whichever
# comes first. Fails unless it is ASCII. <file> and <what> are for messages.
function(pdft_utf16_text out hex at end file what)
  set(text "")
  while(at LESS end)
    math(EXPR digit "${at} * 2")
    string(SUBSTRING "${hex}" ${digit} 4 word)
    string(LENGTH "${word}" digits)
    if(NOT digits EQUAL 4 OR word STREQUAL "0000")
      break()
    endif()
    string(SUBSTRING "${word}" 2 2 high)
    string(SUBSTRING "${word}" 0 2 low)
    if(NOT high STREQUAL "00" OR low STREQUAL "00")
      pdft_gate_fail("${file}: ${what} is not ASCII")
    endif()
    pdft_hex(code "${low}")
    string(ASCII ${code} char)
    string(APPEND text "${char}")
    math(EXPR at "${at} + 2")
  endwhile()
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

# pdft_version_node(<prefix> <hex> <offset> <limit> <file>): one structure of a VERSIONINFO
# resource (VS_VERSIONINFO, StringFileInfo, StringTable, String, VarFileInfo, Var):
#   WORD wLength (the whole structure, children included), WORD wValueLength, WORD wType
#   (1 = text, then wValueLength counts WCHARs; 0 = binary, counting bytes), WCHAR szKey[] with
#   its NUL, padding to a DWORD, the value, padding to a DWORD, the children.
# Offsets are bytes from the start of the resource data, which is where the DWORD alignment is
# counted from. Sets <prefix>_KEY, _TYPE, _VALUE_LENGTH, _VALUE (offset of the value), _CHILDREN
# (offset of the first child) and _END (offset just past the structure). Fails when the structure
# does not fit within <limit> (the end of its parent).
function(pdft_version_node prefix hex offset limit file)
  math(EXPR header_end "${offset} + 6")
  if(header_end GREATER limit)
    pdft_gate_fail("${file}: version resource structure at ${offset} is cut off")
  endif()
  pdft_hex_le(length "${hex}" ${offset} 2)
  pdft_hex_le(value_length "${hex}" ${offset}+2 2)
  pdft_hex_le(type "${hex}" ${offset}+4 2)
  math(EXPR end "${offset} + ${length}")
  if(length LESS 6 OR end GREATER limit)
    pdft_gate_fail("${file}: version resource structure at ${offset} has length ${length}, which does "
                   "not fit in its parent (ends at ${limit})")
  endif()
  pdft_utf16_text(key "${hex}" ${header_end} ${end} "${file}" "a version resource key")
  string(LENGTH "${key}" key_chars)
  math(EXPR key_end "${header_end} + 2 * (${key_chars} + 1)")
  if(key_end GREATER end)
    pdft_gate_fail("${file}: version resource key '${key}' at ${offset} has no terminator")
  endif()
  math(EXPR value "(${key_end} + 3) & ~3")
  if(type EQUAL 1)
    math(EXPR value_bytes "2 * ${value_length}")
  else()
    set(value_bytes ${value_length})
  endif()
  math(EXPR children "(${value} + ${value_bytes} + 3) & ~3")
  set(${prefix}_KEY "${key}" PARENT_SCOPE)
  set(${prefix}_TYPE ${type} PARENT_SCOPE)
  set(${prefix}_VALUE_LENGTH ${value_length} PARENT_SCOPE)
  set(${prefix}_VALUE ${value} PARENT_SCOPE)
  set(${prefix}_CHILDREN ${children} PARENT_SCOPE)
  set(${prefix}_END ${end} PARENT_SCOPE)
endfunction()

# pdft_version_children(<out-list> <hex> <first> <end> <file>): the offsets of a structure's
# children, from <first> (its _CHILDREN) to <end> (its _END). Each child starts on the DWORD
# after the previous one.
function(pdft_version_children out hex first end file)
  set(offsets "")
  set(at ${first})
  while(at LESS end)
    list(APPEND offsets ${at})
    pdft_version_node(child "${hex}" ${at} ${end} "${file}")
    math(EXPR at "(${child_END} + 3) & ~3")
  endwhile()
  set(${out} "${offsets}" PARENT_SCOPE)
endfunction()

# pdft_pe_version(<prefix> <file> <key>...): reads the VERSIONINFO resource (RT_VERSION, the
# first one) by walking its structures, VS_VERSIONINFO -> StringFileInfo -> StringTable ->
# String, each by its wLength, and sets
#   <prefix>_<key>    the value of each <key> (e.g. FileVersion, OriginalFilename) in the
#                     040904b0 string table (or the first table if there is none), or "" if
#                     absent (ASCII values only)
#   <prefix>_FIXED    the VS_FIXEDFILEINFO file version "a.b.c.d", or "" if absent
function(pdft_pe_version prefix file)
  set(fixed "")
  foreach(key IN LISTS ARGN)
    set(value_${key} "")
  endforeach()

  pdft_pe_resources(versions "${file}" 16)
  if(NOT versions)   # no version resource: every value is ""
    set(${prefix}_FIXED "" PARENT_SCOPE)
    foreach(key IN LISTS ARGN)
      set(${prefix}_${key} "" PARENT_SCOPE)
    endforeach()
    return()
  endif()
  list(GET versions 0 version)
  string(REPLACE ":" ";" version "${version}")
  list(GET version 2 data_offset)
  list(GET version 3 data_size)
  pdft_read_hex(hex "${file}" ${data_offset} ${data_size})

  pdft_version_node(root "${hex}" 0 ${data_size} "${file}")
  if(NOT root_KEY STREQUAL "VS_VERSION_INFO")
    pdft_gate_fail("${file}: the version resource starts with '${root_KEY}', not VS_VERSION_INFO")
  endif()
  # VS_FIXEDFILEINFO (52 bytes): dwSignature 0xFEEF04BD, dwStrucVersion, dwFileVersionMS,
  # dwFileVersionLS, ...
  if(root_VALUE_LENGTH GREATER_EQUAL 52)
    math(EXPR digit "${root_VALUE} * 2")
    string(SUBSTRING "${hex}" ${digit} 8 signature)
    if(signature STREQUAL "bd04effe")
      pdft_hex_le(ms "${hex}" ${root_VALUE}+8 4)
      pdft_hex_le(ls "${hex}" ${root_VALUE}+12 4)
      math(EXPR a "${ms} >> 16")
      math(EXPR b "${ms} & 65535")
      math(EXPR c "${ls} >> 16")
      math(EXPR d "${ls} & 65535")
      set(fixed "${a}.${b}.${c}.${d}")
    endif()
  endif()

  # The string table: 040904b0 (U.S. English, Unicode), else the first one.
  set(table "")
  pdft_version_children(blocks "${hex}" ${root_CHILDREN} ${root_END} "${file}")
  foreach(block_at IN LISTS blocks)
    pdft_version_node(block "${hex}" ${block_at} ${root_END} "${file}")
    if(NOT block_KEY STREQUAL "StringFileInfo")
      continue()
    endif()
    pdft_version_children(tables "${hex}" ${block_CHILDREN} ${block_END} "${file}")
    foreach(table_at IN LISTS tables)
      pdft_version_node(candidate "${hex}" ${table_at} ${block_END} "${file}")
      string(TOLOWER "${candidate_KEY}" language)
      if(table STREQUAL "" OR language STREQUAL "040904b0")
        set(table ${table_at})
        set(table_limit ${block_END})
      endif()
      if(language STREQUAL "040904b0")
        break()
      endif()
    endforeach()
  endforeach()

  if(NOT table STREQUAL "")
    pdft_version_node(strings "${hex}" ${table} ${table_limit} "${file}")
    pdft_version_children(entries "${hex}" ${strings_CHILDREN} ${strings_END} "${file}")
    foreach(entry_at IN LISTS entries)
      pdft_version_node(entry "${hex}" ${entry_at} ${strings_END} "${file}")
      if(NOT entry_KEY IN_LIST ARGN)
        continue()
      endif()
      # wValueLength counts WCHARs with the NUL (0 for an empty value); the value ends at its
      # NUL and never past the structure.
      set(text "")
      if(entry_VALUE_LENGTH GREATER 0)
        if(entry_TYPE EQUAL 1)
          math(EXPR value_end "${entry_VALUE} + 2 * ${entry_VALUE_LENGTH}")
        else()
          math(EXPR value_end "${entry_VALUE} + ${entry_VALUE_LENGTH}")
        endif()
        if(value_end GREATER entry_END)
          set(value_end ${entry_END})
        endif()
        pdft_utf16_text(text "${hex}" ${entry_VALUE} ${value_end} "${file}" "the ${entry_KEY} value")
      endif()
      set(value_${entry_KEY} "${text}")
    endforeach()
  endif()

  set(${prefix}_FIXED "${fixed}" PARENT_SCOPE)
  foreach(key IN LISTS ARGN)
    set(${prefix}_${key} "${value_${key}}" PARENT_SCOPE)
  endforeach()
endfunction()
