#pragma code_page(65001)
// Resources of the settings executable (UTF-8; the pragma must stay the first line, or the
// resource compiler reads the file in the ANSI code page). The version resource and the
// manifest are generated by CMake.
#include <windows.h>

#include <commctrl.h>

#include "project_rc.h"
#include "resource_ids.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDR_SAMPLE_DOCUMENT RCDATA "sample-document.pdf"
IDR_SAMPLE_SLIDE    RCDATA "sample-slide.pdf"

IDI_APP ICON "app.ico"

IDA_SETTINGS ACCELERATORS
BEGIN
  VK_F5, IDC_CHECK_NOW, VIRTKEY
END

// Template order is tab order, and what names a control that has no text of its own. Controls
// start disabled; the window turns on what its state allows.
IDD_SETTINGS DIALOGEX 0, 0, 330, 257
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CLASS PDFT_RC_WINDOW_CLASS
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
  LTEXT "Thumbnail zoom", IDC_HEAD_ZOOM, 7, 7, 173, 10
  LTEXT "&Zoom:", IDC_ZOOM_LABEL, 7, 23, 25, 8
  CONTROL "", IDC_ZOOM_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_TOOLTIPS | WS_TABSTOP | WS_DISABLED, 34, 20, 100, 16
  LTEXT "Zoom percent", IDC_ZOOM_EDIT_NAME, 138, 21, 1, 1, NOT WS_VISIBLE
  EDITTEXT IDC_ZOOM_EDIT, 138, 21, 30, 13, ES_NUMBER | ES_AUTOHSCROLL | WS_DISABLED
  CONTROL "", IDC_ZOOM_SPIN, "msctls_updown32", UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS | UDS_HOTTRACK | WS_DISABLED, 158, 21, 10, 13
  LTEXT "%", IDC_ZOOM_PERCENT, 171, 23, 8, 8
  LTEXT "100 % = whole page · 142 % = square crop (A4 portrait)", IDC_ZOOM_HINT, 7, 38, 173, 18
  CONTROL "", IDC_PREVIEW_DOC, "Static", SS_OWNERDRAW, 187, 7, 66, 56
  CONTROL "", IDC_PREVIEW_SLIDE, "Static", SS_OWNERDRAW, 257, 7, 66, 56
  CTEXT "Document", IDC_PREVIEW_DOC_CAPTION, 187, 65, 66, 8
  CTEXT "Slide", IDC_PREVIEW_SLIDE_CAPTION, 257, 65, 66, 8

  LTEXT "Keep thumbnails working", IDC_HEAD_CHECKS, 7, 80, 316, 10
  AUTOCHECKBOX "Check after &PdfCraft updates (30 seconds after it finishes)", IDC_CHECK_PDFCRAFT, 7, 93, 316, 10, WS_TABSTOP | WS_DISABLED
  AUTOCHECKBOX "Check when I sign &in", IDC_CHECK_SIGNIN, 7, 105, 316, 10, WS_TABSTOP | WS_DISABLED

  LTEXT "Status", IDC_HEAD_STATUS, 7, 120, 316, 10
  CONTROL "", IDC_STATUS_GLYPH1, "Static", SS_OWNERDRAW, 7, 133, 10, 10
  LTEXT "", IDC_STATUS_LINE1, 20, 133, 303, 10, SS_NOPREFIX | SS_ENDELLIPSIS
  CONTROL "", IDC_STATUS_GLYPH2, "Static", SS_OWNERDRAW, 7, 145, 10, 10
  LTEXT "", IDC_STATUS_LINE2, 20, 145, 303, 10, SS_NOPREFIX | SS_ENDELLIPSIS
  CONTROL "", IDC_STATUS_GLYPH3, "Static", SS_OWNERDRAW, 7, 157, 10, 10
  LTEXT "", IDC_STATUS_LINE3, 20, 157, 303, 10, SS_NOPREFIX | SS_ENDELLIPSIS
  CONTROL "", IDC_STATUS_FIX, "SysLink", WS_TABSTOP | NOT WS_VISIBLE, 20, 169, 303, 10
  LTEXT "", IDC_STATUS_HINT, 20, 169, 303, 10, SS_NOPREFIX | SS_ENDELLIPSIS | NOT WS_VISIBLE
  PUSHBUTTON "Install for &all users", IDC_INSTALL_MACHINE, 20, 133, 90, 14, NOT WS_VISIBLE | WS_TABSTOP
  PUSHBUTTON "Install for &me only", IDC_INSTALL_USER, 114, 133, 90, 14, NOT WS_VISIBLE | WS_TABSTOP

  LTEXT "", IDC_BANNER, 7, 181, 240, 10, SS_NOPREFIX | SS_ENDELLIPSIS | NOT WS_VISIBLE
  CONTROL "<a>Reopen as the signed-in user</a>", IDC_BANNER_LINK, "SysLink", WS_TABSTOP | NOT WS_VISIBLE, 250, 181, 73, 10
  CONTROL "", IDC_PROGRESS, "msctls_progress32", NOT WS_VISIBLE, 7, 194, 250, 9
  CONTROL "<a>Cancel</a>", IDC_PROGRESS_CANCEL, "SysLink", WS_TABSTOP | NOT WS_VISIBLE, 262, 194, 40, 10

  PUSHBUTTON "&Check now", IDC_CHECK_NOW, 7, 209, 62, 14, WS_TABSTOP | WS_DISABLED
  PUSHBUTTON "&Rebuild thumbnails…", IDC_REBUILD, 73, 209, 88, 14, WS_TABSTOP | WS_DISABLED
  PUSHBUTTON "Open &log", IDC_OPEN_LOG, 165, 209, 56, 14, WS_TABSTOP | WS_DISABLED
  PUSHBUTTON "Copy &diagnostics", IDC_COPY_DIAG, 225, 209, 76, 14, WS_TABSTOP | WS_DISABLED

  PUSHBUTTON "&Uninstall…", IDC_UNINSTALL, 7, 236, 66, 14, WS_TABSTOP | WS_DISABLED
  DEFPUSHBUTTON "&Save", IDOK, 207, 236, 56, 14, WS_TABSTOP | WS_DISABLED
  PUSHBUTTON "Close", IDCANCEL, 267, 236, 56, 14, WS_TABSTOP
END

STRINGTABLE
BEGIN
  IDS_REBUILD_THUMBNAILS "Rebuild thumbnails…"
  IDS_VERSION_CHANGE     "0.14.0 → 0.15.0"
  IDS_SEPARATOR          "·"
  IDS_READING_STATE      "Reading the state of the installation…"
  IDS_STATE_UNREADABLE   "Cannot read the state of the installation: {hr}"
  IDS_BANNER_SANDBOXED   "Open {product} Settings from File Explorer or a normal terminal; changes made here would not reach Windows."
  IDS_BANNER_OTHER_USER  "Running as {account}, not the signed-in user; changes apply to that account."
  IDS_BANNER_BUSY        "A check is running…"
  IDS_CHECKING           "Checking…"
  IDS_CLOSING_AFTER_WORK "Closing when this is done…"
  IDS_FIX                "<a>Fix</a>"
  IDS_FIX_ADMIN          "<a>Fix (needs admin)</a>"
  IDS_FIX_TAKE_BACK      "<a>Use {product} for .pdf</a>"
  IDS_TAKE_BACK_TITLE    "Use {product} for .pdf thumbnails?"
  IDS_TAKE_BACK_TEXT     "These settings belong to another program now:"
  IDS_DIAG_COPIED        "Diagnostics copied; paste them into a GitHub issue."
  IDS_DIAG_FAILED        "Cannot copy the diagnostics: {hr}"
  IDS_LOG_MISSING        "There is no log yet."
  IDS_LOG_FAILED         "Cannot open the log: {hr}"
  IDS_SAVING             "Saving…"
  IDS_STOPPING           "Stopping…"
  IDS_PDFCRAFT_NOT_FOUND " (PdfCraft not found)"
  IDS_ASK_SAVE_TITLE     "Save your changes?"
  IDS_ASK_SAVE_SAVE      "&Save"
  IDS_ASK_SAVE_DONT      "&Don't save"
  IDS_ASK_STOP_TITLE     "Stop refreshing and close?"
  IDS_ASK_STOP_TEXT      "The zoom is saved already. Thumbnails not refreshed yet keep the old zoom until Windows makes them again."
  IDS_ASK_STOP_STOP      "&Stop and close"
  IDS_ASK_STOP_KEEP      "&Keep refreshing"
  IDS_REBUILD_NOW        "&Rebuild now"
  IDS_DONT_ASK_AGAIN     "Don't ask again"
  IDS_ALSO_CLEAR_CACHE   "Also clear the thumbnail cache (restarts File Explorer)"
  IDS_UNINSTALL_NOW      "&Uninstall"
  IDS_CHILD_TITLE_REBUILD "Rebuilding thumbnails"
  IDS_CHILD_TITLE_UNINSTALL "Uninstall"
  IDS_CHILD_TITLE_INSTALL "Install"
  IDS_CHILD_NOT_STARTED  "It could not start: {hr}"
  IDS_NAME_ZOOM_SLIDER   "Zoom"
  IDS_NAME_ZOOM_BOX      "Zoom percent"
  IDS_NAME_ZOOM_ARROWS   "Change the zoom percent"
  IDS_NAME_PROGRESS      "Refresh progress"
  IDS_NAME_GLYPH_OK      "OK"
  IDS_NAME_GLYPH_WARNING "Warning"
  IDS_NAME_GLYPH_PROBLEM "Problem"
  IDS_NAME_TILE_DOC      "Preview of a sample document at {zoom} % zoom"
  IDS_NAME_TILE_SLIDE    "Preview of a sample slide at {zoom} % zoom"
  IDS_BANNER_BLOCKED     "Another program is blocking checks and changes; sign out and in again."
  IDS_BANNER_OTHER_USER_NO_LINK "For the signed-in user, open {product} Settings from File Explorer; this window runs as {account}."
END
