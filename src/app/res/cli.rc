#pragma code_page(65001)
// Resources of the command-line executable (UTF-8; the pragma must stay the first line, or the
// resource compiler reads the file in the ANSI code page). The version resource and the
// manifest are generated by CMake.
#include <windows.h>

#include "resource_ids.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
  IDS_REBUILD_THUMBNAILS "Rebuild thumbnails…"
  IDS_VERSION_CHANGE     "0.14.0 → 0.15.0"
  IDS_SEPARATOR          "·"
END
